<section class="form-card">
  <h1>Nova Entrega</h1>

  <% if (erros && erros.length > 0) { %>
    <div class="validation-errors">
      <strong>Verifique os dados:</strong>

      <ul>
        <% erros.forEach((erro) => { %>
          <li><%= erro.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/entregas">
    <div class="form-group">
      <label for="descricao">Descrição</label>

      <input
        type="text"
        id="descricao"
        name="descricao"
        value="<%= dados.descricao || '' %>"
      >
    </div>

    <div class="form-group">
      <label for="origem">Origem</label>

      <input
        type="text"
        id="origem"
        name="origem"
        value="<%= dados.origem || '' %>"
      >
    </div>

    <div class="form-group">
      <label for="destino">Destino</label>

      <input
        type="text"
        id="destino"
        name="destino"
        value="<%= dados.destino || '' %>"
      >
    </div>

    <div class="actions">
      <button type="submit" class="btn">
        Cadastrar Entrega
      </button>

      <a href="/entregas" class="btn btn-secondary">
        Voltar
      </a>
    </div>
  </form>
</section>