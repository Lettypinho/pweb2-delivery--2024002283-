<section class="page-header">
  <div>
    <h1>Entregas</h1>
    <p>Acompanhe todas as entregas cadastradas.</p>
  </div>

  <a href="/entregas/nova" class="btn">
    Nova Entrega
  </a>
</section>

<form method="GET" action="/entregas" class="filter-form">
  <label for="status">Filtrar por status</label>

  <select name="status" id="status">
    <option value="">Todos</option>

    <option
      value="CRIADA"
      <%= statusSelecionado === 'CRIADA' ? 'selected' : '' %>
    >
      CRIADA
    </option>

    <option
      value="EM_TRANSITO"
      <%= statusSelecionado === 'EM_TRANSITO' ? 'selected' : '' %>
    >
      EM_TRANSITO
    </option>

    <option
      value="ENTREGUE"
      <%= statusSelecionado === 'ENTREGUE' ? 'selected' : '' %>
    >
      ENTREGUE
    </option>

    <option
      value="CANCELADA"
      <%= statusSelecionado === 'CANCELADA' ? 'selected' : '' %>
    >
      CANCELADA
    </option>
  </select>

  <button type="submit" class="btn">
    Filtrar
  </button>
</form>

<% if (entregas.length === 0) { %>
  <div class="empty">
    Nenhuma entrega encontrada.
  </div>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Descrição</th>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% entregas.forEach((entrega) => { %>
        <tr>
          <td><%= entrega.id %></td>
          <td><%= entrega.descricao %></td>
          <td><%= entrega.origem %></td>
          <td><%= entrega.destino %></td>

          <td>
            <span class="badge badge-<%= entrega.status.toLowerCase() %>">
              <%= entrega.status %>
            </span>
          </td>

          <td>
            <a href="/entregas/<%= entrega.id %>">
              Ver detalhes
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>