<section class="form-card">
  <h1>Novo Motorista</h1>

  <% if (erros && erros.length > 0) { %>
    <div class="validation-errors">
      <strong>Verifique os dados:</strong>

      <ul>
        <% erros.forEach((erro) => { %>
          <li><%= erro.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/motoristas">
    <div class="form-group">
      <label for="nome">Nome</label>

      <input
        type="text"
        id="nome"
        name="nome"
        value="<%= dados.nome || '' %>"
      >
    </div>

    <div class="form-group">
      <label for="cpf">CPF</label>

      <input
        type="text"
        id="cpf"
        name="cpf"
        value="<%= dados.cpf || '' %>"
      >
    </div>

    <div class="form-group">
      <label for="placaVeiculo">Placa do veículo</label>

      <input
        type="text"
        id="placaVeiculo"
        name="placaVeiculo"
        value="<%= dados.placaVeiculo || '' %>"
      >
    </div>

    <div class="actions">
      <button type="submit" class="btn">
        Cadastrar Motorista
      </button>

      <a href="/motoristas" class="btn btn-secondary">
        Voltar
      </a>
    </div>
  </form>
</section>